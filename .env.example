# Copier ce fichier en .env puis remplir (le .env n'est jamais commité).
# Tout est optionnel : sans LLM, triage par règles ; sans Telegram, résultats dans les logs/Kibana.

# --- LLM : n'importe quelle API compatible OpenAI ---
# Groq (offre gratuite) :
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=
# Ollama en local (sans clé, mettre une valeur quelconque) :
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=llama3.1
# LLM_API_KEY=ollama

# --- Telegram ---
# 1. Créer un bot avec @BotFather → récupérer le token
# 2. Envoyer un message au bot, puis ouvrir https://api.telegram.org/bot<TOKEN>/getUpdates → "chat":{"id":...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
